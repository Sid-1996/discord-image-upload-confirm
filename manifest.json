{
  "manifest_version": 3,
  "default_locale": "zh_TW",
  "name": "__MSG_extName__",
  "version": "1.0.0",
  "author": "Sid-1996",
  "description": "__MSG_extDesc__",
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://discord.com/*",
    "https://stoat.chat/*",
    "https://*.stoat.chat/*",
    "https://uguu.se/*",
    "https://imglink.cc/*"
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://discord.com/*"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://stoat.chat/*", "https://*.stoat.chat/*"],
      "js": ["i18n.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
